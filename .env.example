# Runtime
PERSONMETER_ENV=development
DJANGO_SECRET_KEY=replace-with-a-secure-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Development database
SQLITE_NAME=db.sqlite3

# Production PostgreSQL
DB_NAME=personmeter
DB_USER=personmeter_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Production AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# Optional (production reverse proxy)
DJANGO_CSRF_TRUSTED_ORIGINS=https://personmeter.net,https://www.personmeter.net
