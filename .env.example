# Runtime
PERSONMETER_ENV=development
DJANGO_SECRET_KEY=replace-with-a-secure-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Development database
SQLITE_NAME=db.sqlite3

# Production PostgreSQL
DB_NAME=personmeter
DB_USER=personmeter_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Production AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# Optional (production reverse proxy)
DJANGO_CSRF_TRUSTED_ORIGINS=https://personmeter.net,https://www.personmeter.net

# Production security hardening
DJANGO_USE_X_FORWARDED_HOST=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=true
DJANGO_SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
DJANGO_X_FRAME_OPTIONS=DENY
DJANGO_WHITENOISE_MAX_AGE=31536000

# Upload hardening
PERSONMETER_MAX_IMAGE_UPLOAD_MB=5
PERSONMETER_MAX_IMAGE_PIXELS=25000000
PERSONMETER_ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
PERSONMETER_ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp,.gif
PERSONMETER_ALLOWED_IMAGE_FORMATS=JPEG,PNG,WEBP,GIF
